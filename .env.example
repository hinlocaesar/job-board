# Copy to .env (gitignored) and adjust. Never commit real values.

# --- Marketplace API (PostgreSQL 18 @ localhost:5432) ---
ConnectionStrings__Marketplace=Host=127.0.0.1;Port=5432;Database=jobboard;Username=jobboard;Password=jobboard_dev
ConnectionStrings__MarketplaceTest=Host=127.0.0.1;Port=5432;Database=jobboard_test;Username=jobboard;Password=jobboard_dev

# --- JWT (Marketplace API) ---
Jwt__Issuer=JobBoard
Jwt__Audience=JobBoard
Jwt__AccessTokenSecret=CHANGE_ME__64+chars_random_string
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# --- Public URLs (dev) ---
Umbraco__BaseUrl=https://localhost:7123
VITE_API_BASE=/api
VITE_UMBRACO_BASE=/umbraco/delivery/api/v2

# Dev-server proxy targets (Vite rewrites /api and /umbraco to these)
VITE_PROXY_API=http://localhost:5201
VITE_PROXY_UMBRACO=https://localhost:7123

# --- Umbraco Developer MCP (dev instance ONLY, never production) ---
# Fill after creating an API user in the backoffice (Users -> API users),
# then set "enabled": true for umbraco-mcp in opencode.json.
UMBRACO_CLIENT_ID=
UMBRACO_CLIENT_SECRET=
UMBRACO_BASE_URL=https://localhost:7123

# --- Email (dev: writes to log / file, no real SMTP) ---
Email__Provider=Log

# --- Umbraco unattended install (dev instance ONLY; set as env vars before first `dotnet run`) ---
Umbraco__CMS__Unattended__UnattendedUserName=Umbraco Admin
Umbraco__CMS__Unattended__UnattendedUserEmail=admin@jobboard.local
Umbraco__CMS__Unattended__UnattendedUserPassword=CHANGE_ME_strong_password
